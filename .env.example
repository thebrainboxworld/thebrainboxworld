# Public site URL used for canonical tags, Open Graph URLs, robots.txt, sitemap.xml, and email branding.
# Use your final production domain when it is attached in Vercel, for example:
# VITE_SITE_URL=https://www.yourdomain.com
# SITE_URL=https://www.yourdomain.com
VITE_SITE_URL=https://your-vercel-domain.vercel.app
SITE_URL=https://your-vercel-domain.vercel.app

# Supabase public client variables. These are safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Supabase server variables used only by Vercel Functions/API routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram lead notifications. Optional, but required for Telegram alerts.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Email lead notifications through @lovable.dev/email-js. Optional, but required for email alerts.
LOVABLE_API_KEY=your-lovable-email-api-key
LEADS_FROM_EMAIL=leads@your-verified-sender-domain.com
LEADS_SENDER_DOMAIN=your-verified-sender-domain.com